import { Theme } from "theme.slint";

export component IconLyraLogo inherits Rectangle {
    in property <color> icon_color: Theme.ink;
    in property <length> icon_size: 18px;
    width: icon_size;
    height: icon_size;

    Path {
        width: 100%;
        height: 100%;
        stroke: root.icon_color;
        stroke-width: 1.75px;
        fill: transparent;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 4 4 v 8 a 8 8 0 0 0 16 0 v -8 M 4 4 h 16 M 9 4 v 12 M 15 4 v 12 M 12 20 v 3 M 9 23 h 6";
    }
}

