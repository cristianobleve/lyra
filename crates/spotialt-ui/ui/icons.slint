export component IconShuffle inherits Rectangle {
    in property <color> icon_color: Theme.mute;
    in property <bool> active: false;
    in property <length> icon_size: 16px;
    width: icon_size;
    height: icon_size;

    Path {
        width: 100%;
        height: 100%;
        stroke: root.active ? #ffffff : root.icon_color;
