export component IconHeart inherits Rectangle {
    in property <color> icon_color: Theme.mute;
    in property <bool> filled: false;
    in property <length> icon_size: 16px;
    width: icon_size;
    height: icon_size;

    Path {
        width: 100%;
        height: 100%;
        fill: root.filled ? root.icon_color : transparent;
        stroke: root.icon_color;
        stroke-width: root.filled ? 0px : 1.75px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 19.5 12.572 l -7.5 7.428 l -7.5 -7.428 a 5 5 0 1 1 7.5 -6.566 a 5 5 0 1 1 7.5 6.572";
    }
}

